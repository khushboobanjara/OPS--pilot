# Copy this file to .env (which is git-ignored) and fill it in:   cp .env.example .env
# Use a THROWAWAY mailbox, never your real one, and never commit .env.
# Gmail: turn on 2-step verification, then create an App Password (Google Account > Security > App passwords).
OPSPILOT_IMAP_HOST=imap.gmail.com
OPSPILOT_IMAP_PORT=993
OPSPILOT_IMAP_USER=
OPSPILOT_IMAP_PASSWORD=
OPSPILOT_IMAP_FOLDER=INBOX
OPSPILOT_API_URL=http://127.0.0.1:8000
OPSPILOT_POLL_INTERVAL_SECONDS=60

# Optional
# OPSPILOT_API_KEY=            # when set, every API call must send header X-API-Key
# OPSPILOT_DEMO_MODE=false     # true = public showcase (sample data, rate limits, hourly reset)
